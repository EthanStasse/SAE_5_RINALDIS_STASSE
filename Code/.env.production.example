# Modèle de configuration de production / recette.
# Copier en .env.production (ignoré par Git) et remplir les valeurs vides.
# Ne jamais versionner .env.production. Éviter le caractère $ dans les mots de passe.

APP_NAME=Cocagne
APP_ENV=production
# À générer : docker run --rm cocagne-app:local php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Nom de domaine servi par Caddy en HTTPS : localhost en test, le vrai domaine en recette.
SITE_ADDRESS=localhost

# Images à lancer (en recette : celles publiées sur ghcr.io).
APP_IMAGE=cocagne-app:local
WEB_IMAGE=cocagne-web:local

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=cocagne
DB_USERNAME=cocagne
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Aucune tâche n'est mise en file d'attente : exécution immédiate.
QUEUE_CONNECTION=sync

# En test local : MAIL_MAILER=log (les e-mails vont dans le journal).
# En recette : smtp, avec les paramètres du fournisseur d'e-mails.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
